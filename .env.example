# ---- 这个服务是整个 VelaShell 生态的信任根 ----
# 下面三项改了会有连锁后果,看清楚再动。

# ⚠️ issuer:令牌里的 iss、discovery 里所有端点的前缀、浏览器点"登录"跳过去的地址。
# 必须是**浏览器能打开**的地址。改了 → 所有已发出的令牌立刻失效,
# 且每个下游服务的 Auth__Issuer 都要同步改。
IDENTITY_ISSUER=https://auth.easilynet.top
IDENTITY_REQUIRE_HTTPS=true
IDENTITY_PORT=7020

# ---- MongoDB ----
# 留空则用本 compose 自带的那个(开发用)。生产上指向共享副本集,
# 库名必须仍是 velashell-identity —— 改了等于所有账号消失。
MONGO_CONNECTION=
MONGO_ROOT_USER=identity
MONGO_ROOT_PASSWORD=change-me-please
MONGO_PORT=27020

# ---- 下游服务的回跳地址 ----
MARKET_WEB_ORIGIN=https://market.easilynet.top
FEEDS_ORIGIN=https://feeds.easilynet.top
FEEDS_CLIENT_SECRET=

# ---- 账号 ----
ALLOW_SELF_REGISTRATION=true
# 首个账号:只在账号集合为空时创建。sub 会打在启动日志里。
# 三项要么都填要么都不填 —— 邮箱是必填项,漏填则账号建不出来。
BOOTSTRAP_USER=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_EMAIL=

# ---- 发信(找回口令)----
# 留空 MAIL_HOST 就等于关掉找回口令:页面会直说"本部署没开通发信",不会让人白等一封信。
# 端口 587 配 MAIL_IMPLICIT_TLS=false(STARTTLS);端口 465 配 true(隐式 TLS)。
# MAIL_PASSWORD 多数服务商要的是「授权码」而不是邮箱登录口令。
# MAIL_FROM 留空则用 MAIL_USER —— 多数服务商也要求发件地址与登录账号一致。
MAIL_HOST=
MAIL_PORT=587
MAIL_IMPLICIT_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=VelaShell 统一认证

ASPNETCORE_ENVIRONMENT=Production
