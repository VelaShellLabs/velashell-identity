@page "/account/reset"
@model ResetPasswordModel
@{
    ViewData["Title"] = "设置新口令";
}

@section Aside {
    <div class="aside-pitch">
        <h2>设置一把新口令。</h2>
        <p>提交之后这条链接立刻作废,你在其它设备上的登录状态也会被一并清掉。</p>
        <ul class="aside-points">
            <li>
                <span class="mark">@await Html.PartialAsync("_Icon", "rotate")</span>
                <span>
                    <b>所有设备都会被登出</b>
                    <span>刷新令牌同时失效。这正是"口令可能已经泄露"时该有的结果。</span>
                </span>
            </li>
            <li>
                <span class="mark">@await Html.PartialAsync("_Icon", "lock")</span>
                <span>
                    <b>顺带解除锁定</b>
                    <span>之前因连续输错而被临时锁住的账号,重置后立刻可以登录。</span>
                </span>
            </li>
        </ul>
    </div>
}

<h1>设置新口令</h1>

@if (!Model.TokenValid)
{
    @* 不存在、已过期、已用过 —— 一律同一句话,不透露是哪一种。 *@
    <p class="lede">这条链接不能用了。</p>
    <p class="notice error">
        @await Html.PartialAsync("_Icon", "alert")
        <span>链接无效、已过期,或者已经被使用过。重新申请一条即可。</span>
    </p>
    <p class="alt"><a asp-page="/Account/ForgotPassword">重新申请找回链接</a> · <a asp-page="/Account/Login">回到登录</a></p>
}
else
{
    <p class="lede">这条链接只能用这一次,提交后即作废。</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="notice error">
            @await Html.PartialAsync("_Icon", "alert")
            <span>@Model.Error</span>
        </p>
    }

    <form method="post">
        <input type="hidden" asp-for="Token" />

        <label>
            <span>新口令</span>
            <span class="control">
                @await Html.PartialAsync("_Icon", "key")
                <input asp-for="Input.Password" type="password" autocomplete="new-password" autofocus required placeholder="••••••••" />
                <button type="button" class="reveal" data-reveal="@Html.IdFor(m => m.Input.Password)" aria-label="显示口令">
                    @await Html.PartialAsync("_Icon", "eye")
                </button>
            </span>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </label>

        @* 强度条只判断长度与字符类别这几条能自己判断的;真正的口令策略在服务端。 *@
        <div class="strength" data-score="0" data-strength-for="@Html.IdFor(m => m.Input.Password)"></div>

        <label>
            <span>再输一次</span>
            <span class="control">
                @await Html.PartialAsync("_Icon", "lock")
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required placeholder="••••••••" />
                <button type="button" class="reveal" data-reveal="@Html.IdFor(m => m.Input.ConfirmPassword)" aria-label="显示口令">
                    @await Html.PartialAsync("_Icon", "eye")
                </button>
            </span>
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </label>

        <p class="notice warn">
            @await Html.PartialAsync("_Icon", "alert")
            <span>提交后所有设备都会被登出,需要用新口令重新登录一次。</span>
        </p>

        <button type="submit">设置新口令并登出所有设备</button>
    </form>
}

<p class="foot-note">
    @await Html.PartialAsync("_Icon", "shield")
    <span>口令至少 @Model.MinimumPasswordLength 位。这个页面永远不会向你要旧口令。</span>
</p>
