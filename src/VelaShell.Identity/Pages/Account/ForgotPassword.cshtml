@page "/account/forgot"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "找回口令";
}

@section Aside {
    <div class="aside-pitch">
        <h2>忘了口令,用邮箱换一把。</h2>
        <p>我们会往你注册时填的邮箱发一条一次性链接。在你点开它之前,原来的口令一直有效。</p>
        <ul class="aside-points">
            <li>
                <span class="mark">@await Html.PartialAsync("_Icon", "key")</span>
                <span>
                    <b>链接只能用一次</b>
                    <span>用过即作废,同一个账号之前申请过的链接也会一起失效。</span>
                </span>
            </li>
            <li>
                <span class="mark">@await Html.PartialAsync("_Icon", "rotate")</span>
                <span>
                    <b>重置会踢掉所有设备</b>
                    <span>换口令等于换安全戳,别处的会话与刷新令牌立刻失效。</span>
                </span>
            </li>
        </ul>
    </div>
}

<h1>找回口令</h1>

@if (!Model.MailEnabled)
{
    <p class="lede">这个部署没有开通发信。</p>
    <p class="notice warn">
        @await Html.PartialAsync("_Icon", "alert")
        <span>
            管理员还没有配置 SMTP(<code>Mail__Host</code>),所以这里发不出找回邮件。
            请直接联系部署方重置口令。
        </span>
    </p>
    <p class="alt"><a asp-page="/Account/Login">回到登录</a></p>
}
else if (Model.Submitted)
{
    @* 不论邮箱是否存在,这里都是同一句话 —— 措辞上的任何差别都会变成账号枚举器。 *@
    <p class="lede">如果这个邮箱下有账号,信已经在路上了。</p>
    <p class="notice ok">
        @await Html.PartialAsync("_Icon", "check")
        <span>
            请查收邮件并点开里面的链接,它在 @Model.Lifetime.TotalMinutes.ToString("0") 分钟内有效。
            没收到的话看一眼垃圾邮件;短时间内重复申请不会再发新的信。
        </span>
    </p>
    <p class="alt">想起来了?<a asp-page="/Account/Login">直接登录</a></p>
}
else
{
    <p class="lede">填你注册时用的邮箱,我们发一条一次性链接过去。</p>

    <form method="post">
        <label>
            <span>邮箱</span>
            <span class="control">
                @await Html.PartialAsync("_Icon", "mail")
                <input asp-for="Input.Email" type="email" autocomplete="email" autofocus required placeholder="you@example.com" />
            </span>
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </label>

        <button type="submit">发送找回链接</button>
    </form>

    <p class="alt">想起来了?<a asp-page="/Account/Login">直接登录</a></p>
}

<p class="foot-note">
    @await Html.PartialAsync("_Icon", "shield")
    <span>我们不会在信里索要你的口令。任何让你回复口令的邮件都不是我们发的。</span>
</p>
